{
  "name": "mdse",
  "private": true,
  "description": "Markdown Systems Engineering: rules, schemas and tools for an Obsidian vault backed by SysML v2 text.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "npm run check:rules && npm run check:language && npm run test:core && npm run test:workbench && npm run check:workbench && npm run test:importer && npm run check:importer && npm run test:oracles && npm run test:fixtures",
    "check:rules": "node scripts/check-rules.mjs",
    "check:language": "node --no-warnings scripts/build-language.mjs",
    "language:write": "node --no-warnings scripts/build-language.mjs --write",
    "rules:write": "node scripts/check-rules.mjs --write",
    "test:core": "node --test tools/core/test/*.test.mjs",
    "test:importer": "node --no-warnings --test tools/importer/test/*.test.ts",
    "build:importer": "node tools/importer/build.mjs",
    "check:importer": "node tools/importer/build.mjs --check",
    "test:oracles": "python3 -m pytest -q testing/oracles",
    "test:fixtures": "python3 testing/fixtures/golden-charger/extract_sysml.py --check && python3 testing/fixtures/golden-charger/validate_fixture.py && python3 testing/fixtures/golden-charger/test_fixture_pipeline.py",
    "test:workbench": "node --no-warnings --test tools/workbench/test/*.test.ts",
    "build:workbench": "node tools/workbench/build.mjs",
    "check:workbench": "node tools/workbench/build.mjs --check",
    "build": "npm run build:workbench && npm run build:importer"
  }
}
